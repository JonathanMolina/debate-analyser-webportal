# ==============================================================================
# ARGUMETA - PORTAL PÚBLICO (EXEMPLO)
# ==============================================================================

# Supabase (Apenas credenciais públicas de leitura - RLS anon)
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key>

# Configuração de Apoio / Pix
# Opção 1: Informe sua chave Pix direta (e-mail, CPF, celular ou chave aleatória).
# O portal gerará automaticamente o QR Code padrão Banco Central (BR Code) e o código Copia e Cola!
VITE_PIX_KEY=pix@argumeta.com.br
VITE_PIX_NAME=Argumeta
VITE_PIX_CITY=SAO PAULO

# Opção 2: Se você já tiver o código oficial completo "Pix Copia e Cola" gerado pelo seu app bancário,
# você pode colar diretamente aqui (começa com 00020126...):
# VITE_PIX_PAYLOAD=00020126...
