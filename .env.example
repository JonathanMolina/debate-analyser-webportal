# ==============================================================================
# ARGUMETA - PORTAL PÚBLICO (EXEMPLO)
# ==============================================================================

# Supabase (Apenas credenciais públicas de leitura - RLS anon)
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key>

# Configuração de Apoio / Doações / Pagamento
# Link de cobrança / pagamento do Mercado Pago (ou checkout customizado)
# Pode ser pago via Pix, Cartão de Crédito, Boleto, etc.
# Exemplo: https://link.mercadopago.com.br/argumeta ou link.mercadopago.com.br/argumeta
VITE_PAYMENT_URL=https://link.mercadopago.com.br/argumeta
